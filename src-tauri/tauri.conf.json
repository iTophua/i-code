{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iCode",
  "version": "0.1.0",
  "identifier": "com.i-code.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iCode",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["js","jsx","ts","tsx","json","html","css","scss","less","vue","svelte"],
        "name": "Source Code",
        "role": "Editor"
      },
      {
        "ext": ["py","rb","go","rs","java","kt","c","cpp","h","hpp","cs","php","swift","dart","lua","r","scala","pl","sh","bash","zsh","fish","ps1","bat","cmd"],
        "name": "Source Code",
        "role": "Editor"
      },
      {
        "ext": ["xml","yaml","yml","toml","ini","conf","cfg","env","gitignore","dockerfile","makefile"],
        "name": "Config File",
        "role": "Editor"
      },
      {
        "ext": ["md","markdown","txt","log","csv","tsv"],
        "name": "Text Document",
        "role": "Editor"
      },
      {
        "ext": ["sql","graphql","gql","proto"],
        "name": "Data File",
        "role": "Editor"
      },
      {
        "ext": ["png","jpg","jpeg","gif","svg","webp","bmp","ico"],
        "name": "Image",
        "role": "Viewer"
      }
    ]
  }
}
